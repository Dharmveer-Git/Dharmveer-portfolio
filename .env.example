PORT=5001
HOST=127.0.0.1
NODE_ENV=development

# Required in production. Local `npm run dev` starts a persistent development MongoDB when omitted.
MONGODB_URI=mongodb+srv://DB_USERNAME:NEW_DB_PASSWORD@YOUR_CLUSTER_HOST/portfolio?retryWrites=true&w=majority&appName=Cluster0
MONGODB_DB_NAME=portfolio
MONGODB_LOCAL_FALLBACK=false
# Optional DNS override when the network resolver cannot resolve Atlas SRV records.
MONGODB_DNS_SERVERS=

# Use a long, random secret and private credentials. Never commit real values.
JWT_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=REPLACE_WITH_AT_LEAST_8_CHARACTERS

CLIENT_URL=http://localhost:5173
VITE_API_URL=/api

# Point this at persistent storage in production.
UPLOAD_DIR=server/uploads
