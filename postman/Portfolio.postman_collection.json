    {
      "name": "Project CRUD - run in order",
      "item": [
        {
          "name": "Create test project",
          "request": {
            "method": "POST",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/projects",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Postman CRUD test\",\n  \"description\": \"Disposable API test project\",\n  \"tags\": [\n    \"Node.js\"\n  ],\n  \"active\": false\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 201', () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.unset('projectId');",
                  "if (pm.response.code === 201) pm.collectionVariables.set('projectId', pm.response.json()._id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Get draft - hidden publicly",
          "request": {
            "method": "GET",
            "auth": {
              "type": "noauth"
            },
            "header": [],
            "url": "{{baseUrl}}/api/projects/{{projectId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 404', () => pm.response.to.have.status(404));"
                ]
              }
            }
          ]
        },
        {
          "name": "PUT replace test project",
          "request": {
            "method": "PUT",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/projects/{{projectId}}",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Postman updated project\",\n  \"description\": \"Updated via PUT\",\n  \"tags\": [\n    \"Node.js\"\n  ],\n  \"active\": true\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
