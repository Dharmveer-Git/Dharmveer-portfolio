                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                  "pm.test('Title preserved', () => pm.expect(pm.response.json().title).to.eql('Postman updated project'));"
                ]
              }
            }
          ]
        },
